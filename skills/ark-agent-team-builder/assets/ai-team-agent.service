# ai-team-agent.service — systemd unit（Linux 開機自啟）
#
# 安裝：
#   sudo cp scripts/ai-team-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable ai-team-agent
#   sudo systemctl start ai-team-agent
#
# 查看日誌：
#   journalctl -u ai-team-agent -f

[Unit]
Description=Ark AI Agent Team Platform
After=network.target

[Service]
Type=simple
User=paddyyang
WorkingDirectory=/home/paddyyang/kiro-cli/ai-team-agent
Environment=PATH=/home/paddyyang/kiro-cli/ai-team-agent/.venv/bin:/usr/local/bin:/usr/bin
ExecStart=/home/paddyyang/kiro-cli/ai-team-agent/.venv/bin/python start.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
